# ─────────────────────────────────────────────────────────────
# Firebase — klient (Firebase Web SDK)
# Wartości znajdziesz w Konsoli Firebase → Ustawienia projektu →
# Twoje aplikacje → Konfiguracja SDK
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=twoj-projekt.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=twoj-projekt
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=twoj-projekt.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────
# Firebase — serwer (Firebase Admin SDK)
# Wymagane do zapisu zgłoszeń i wiadomości przez Server Actions
# oraz do uruchomienia skryptu seed: npm run seed:firestore
#
# Konsola Firebase → Ustawienia projektu → Konta serwisowe →
# „Wygeneruj nowy klucz prywatny” (klucz trzymaj poza repozytorium!)
# ─────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=twoj-projekt
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@twoj-projekt.iam.gserviceaccount.com
# Klucz prywatny musi zachować znaki nowej linii — w jednym pliku wpisuj \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Alternatywnie: cały klucz serwisowy jako JSON w jednej zmiennej
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ─────────────────────────────────────────────────────────────
# Tryb deweloperski — lokalne emulatory Firebase (opcjonalnie)
# Uruchomienie: firebase emulators:start --only auth,firestore
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_EMULATOR_AUTH_URL=http://127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_EMULATOR_FIRESTORE_PORT=8080
